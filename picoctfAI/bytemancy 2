from pwn import *

# Set the target host and port provided in the challenge
host = 'lonely-island.picoctf.net'
port = 52314

# Connect to the remote server
r = remote(host, port)

# Wait until the prompt appears
r.recvuntil(b'==> ')

# Send the raw bytes: three instances of 0xFF
# b'\xff\xff\xff' represents the binary data, not the text string "\xff"
r.sendline(b'\xff\xff\xff')

# Receive and print the response (the flag)
print(r.recvall().decode())   
                                                                                                                                                                      
