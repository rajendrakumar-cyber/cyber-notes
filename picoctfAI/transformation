with open("enc", "r", encoding="utf-8") as f:
    encoded_str = f.read().strip()

flag = ""

# Loop through each 16-bit character
for char in encoded_str:
    val = ord(char)
    
    # Extract the first character (high byte)
    first_char = chr(val >> 8)
    
    # Extract the second character (low byte)
    second_char = chr(val & 0xFF)
    
    flag += first_char + second_char

